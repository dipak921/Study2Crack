        <div class="col-lg-8">
            <h2 class="display-5 fw-bold text-light mb-4">Start your learning journey today!</h2>
            <div class="d-flex justify-content-center gap-3 mb-5">
                <a href="/Learn" class="btn btn-primary btn-lg shadow px-4">Get Started</a>
                <a href="/Home/Contact" class="btn btn-outline-light btn-lg px-4">Contact Us</a>
            </div>
            <p class="text-secondary">Have questions? Email us directly at <a href="mailto:support@study2crack.com" class="text-info text-decoration-none">support@study2crack.com</a></p>
        </div>
    </div>
</div>
