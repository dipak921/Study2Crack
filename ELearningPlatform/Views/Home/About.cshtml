@{
    ViewData["Title"] = "About Us";
}

<!-- A. Hero Section -->
<div class="container-fluid py-5 text-center shadow-lg" style="background: linear-gradient(135deg, rgba(15,23,42,1) 0%, rgba(30,41,59,1) 100%);">
    <div class="row pt-4 pb-5 justify-content-center">
        <div class="col-lg-8">
            <h1 class="display-4 fw-bolder mb-3" style="color: #38bdf8;">About Our Platform</h1>
            <p class="lead text-light opacity-75 mb-4" style="font-size: 1.4rem;">
                Learn coding with simple explanations and real examples.
            </p>
            <a href="/Learn" class="btn btn-primary btn-lg px-5 py-3 fw-bold shadow-sm" style="border-radius: 8px;">Explore Courses &rarr;</a>
        </div>
    </div>
</div>

<div class="container mt-5 pt-3">
    <!-- B. Introduction -->
    <div class="row mb-5 justify-content-center">
        <div class="col-lg-10 text-center">
            <h2 class="fw-bold text-light mb-4">Who We Are</h2>
            <p class="fs-5 text-secondary" style="line-height: 1.8;">
                Study2Crack is a dedicated E-learning hub specializing exclusively in high-quality, text-based learning. We strip away the fluff and focus purely on delivering crystal clear, straightforward explanations intertwined with practical code examples. No lengthy videos, no distractions—just pure coding knowledge at your own pace.
            </p>
        </div>
    </div>

    <!-- C. Mission & Vision -->
    <div class="row g-4 mb-5 pb-5">
        <div class="col-md-6">
            <div class="card h-100 border-0 shadow" style="background: rgba(30, 41, 59, 0.4); border-radius: 16px;">
                <div class="card-body p-5">
                    <div class="mb-4 text-info"><i class="fas fa-rocket fa-3x"></i></div>
                    <h3 class="fw-bold text-light">Our Mission</h3>
                    <p class="text-secondary mt-3 fs-5">To make learning programming easy, accessible, and completely distraction-free for everyone, regardless of their background.</p>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card h-100 border-0 shadow" style="background: rgba(30, 41, 59, 0.4); border-radius: 16px;">
                <div class="card-body p-5">
                    <div class="mb-4 text-warning"><i class="fas fa-eye fa-3x"></i></div>
                    <h3 class="fw-bold text-light">Our Vision</h3>
                    <p class="text-secondary mt-3 fs-5">To become the world's leading text-based platform for beginner-friendly, highly practical software education.</p>
                </div>
            </div>
        </div>
    </div>

    <!-- D. What We Offer & E. Why Choose Us -->
    <div class="row mb-5 pb-5">
        <div class="col-lg-6 mb-4 mb-lg-0">
            <h3 class="fw-bold text-light mb-4 border-bottom border-secondary pb-2">What We Offer</h3>
            <ul class="list-group list-group-flush fs-5">
                <li class="list-group-item bg-transparent text-secondary border-0 px-0 d-flex align-items-center"><i class="fas fa-check-circle text-success me-3"></i> Text-based tutorials</li>
                <li class="list-group-item bg-transparent text-secondary border-0 px-0 d-flex align-items-center"><i class="fas fa-check-circle text-success me-3"></i> Rich code examples</li>
                <li class="list-group-item bg-transparent text-secondary border-0 px-0 d-flex align-items-center"><i class="fas fa-check-circle text-success me-3"></i> Beginner to advanced courses</li>
                <li class="list-group-item bg-transparent text-secondary border-0 px-0 d-flex align-items-center"><i class="fas fa-check-circle text-success me-3"></i> Easy-to-understand content</li>
            </ul>
        </div>
        <div class="col-lg-6">
            <h3 class="fw-bold text-light mb-4 border-bottom border-secondary pb-2">Why Choose Us</h3>
            <div class="row g-3">
                <div class="col-sm-6">
                    <div class="p-4 rounded shadow-sm text-center" style="background: rgba(15, 23, 42, 0.6); transition: transform 0.3s;" onmouseover="this.style.transform='translateY(-5px)'" onmouseout="this.style.transform='translateY(0)'">
                         <i class="fas fa-comment-dots text-info fs-2 mb-3"></i>
                         <h5 class="text-light">Simple Explanations</h5>
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="p-4 rounded shadow-sm text-center" style="background: rgba(15, 23, 42, 0.6); transition: transform 0.3s;" onmouseover="this.style.transform='translateY(-5px)'" onmouseout="this.style.transform='translateY(0)'">
                         <i class="fas fa-ban text-danger fs-2 mb-3"></i>
                         <h5 class="text-light">No Distractions</h5>
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="p-4 rounded shadow-sm text-center" style="background: rgba(15, 23, 42, 0.6); transition: transform 0.3s;" onmouseover="this.style.transform='translateY(-5px)'" onmouseout="this.style.transform='translateY(0)'">
                         <i class="fas fa-laptop-code text-warning fs-2 mb-3"></i>
                         <h5 class="text-light">Practical Learning</h5>
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="p-4 rounded shadow-sm text-center" style="background: rgba(15, 23, 42, 0.6); transition: transform 0.3s;" onmouseover="this.style.transform='translateY(-5px)'" onmouseout="this.style.transform='translateY(0)'">
                         <i class="fas fa-hand-holding-usd text-success fs-2 mb-3"></i>
                         <h5 class="text-light">100% Free Content</h5>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- F. Courses / Categories & G. How It Works -->
