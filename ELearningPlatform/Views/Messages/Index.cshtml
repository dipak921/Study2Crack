@model IEnumerable<ELearningPlatform.Models.ContactMessage>
@{
    ViewData["Title"] = "Contact Messages";
}

<div class="row mb-4 mt-3">
    <div class="col-12">
        <h1 class="display-5 fw-bold" style="color: #e2e8f0;">Inbox</h1>
        <p class="text-secondary fs-5 mt-2">Manage inquiries submitted through the public contact form.</p>
    </div>
</div>

<div class="table-responsive">
    <table class="table table-dark table-hover table-striped mb-5" style="border-radius: 8px; overflow: hidden; border: 1px solid rgba(255,255,255,0.05);">
        <thead>
            <tr style="background: rgba(15, 23, 42, 0.9);">
                <th style="width: 15%;">Received</th>
                <th style="width: 15%;">Sender</th>
                <th style="width: 20%;">Subject</th>
                <th style="width: 40%;">Message</th>
                <th style="width: 10%;" class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    <tr style="vertical-align: middle;">
                        <td class="text-secondary small">
                            <span class="d-block fw-bold text-light">@item.SubmittedAt.ToLocalTime().ToString("MMM dd, yyyy")</span>
                            @item.SubmittedAt.ToLocalTime().ToString("hh:mm tt")
                        </td>
                        <td>
                            <strong class="d-block text-light">@item.Name</strong>
                            <a href="mailto:@item.Email" class="text-info small text-decoration-none">@item.Email</a>
                        </td>
                        <td class="fw-bold text-light">@item.Subject</td>
                        <td>
                            <div style="max-height: 80px; overflow-y: auto; color: #cbd5e1; font-size: 0.9rem;" class="pe-2">
                                @item.MessageText
                            </div>
                        </td>
                        <td class="text-end">
                            <form asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Are you sure you want to delete this message?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Dismiss</button>
                            </form>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="5" class="text-center text-muted py-5 fs-5 bg-dark">
                        <i class="fs-1 d-block mb-3">📬</i>
                        Your inbox is currently empty.
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
