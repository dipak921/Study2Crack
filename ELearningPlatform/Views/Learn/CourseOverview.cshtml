@model ELearningPlatform.Models.Course
@{
    ViewData["Title"] = Model.Title;
}

<div class="row justify-content-center mt-4">
    <div class="col-lg-10">
        <div class="mb-5 pb-4 border-bottom border-secondary row align-items-center">
            <div class="col-md-8">
                <h1 class="display-4 fw-bold text-light">@Model.Title</h1>
                <p class="lead text-secondary mt-3">@Model.Description</p>
            </div>
            <div class="col-md-4 text-md-end mt-4 mt-md-0">
                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    <a asp-controller="Topics" asp-action="Create" asp-route-courseId="@Model.Id" class="btn btn-outline-warning mb-2 d-block w-100 shadow-sm">+ Add Topic (Admin)</a>
                }
                @if (Model.Topics != null && Model.Topics.Any())
                {
                    <a asp-controller="Learn" asp-action="Topic" asp-route-courseId="@Model.Id" class="btn btn-primary btn-lg shadow">
                        Start First Topic &rarr;
                    </a>
                }
            </div>
        </div>

        <h3 class="fw-bold mb-4" style="color: #cbd5e1;">Course Topics (@Model.Topics?.Count)</h3>

        @if (Model.Topics != null && Model.Topics.Any())
        {
            <div class="list-group list-group-flush" style="background: rgba(30, 41, 59, 0.4); border-radius: 12px; border: 1px solid rgba(255,255,255,0.05);">
                @{ var index = 1; }
                @foreach (var topic in Model.Topics.OrderBy(t => t.Id))
                {
                    <a asp-controller="Learn" asp-action="Topic" asp-route-courseId="@Model.Id" asp-route-topicId="@topic.Id" 
                       class="list-group-item list-group-item-action d-flex align-items-center py-4"
                       style="background: transparent; border-bottom: 1px solid rgba(255,255,255,0.05); color: #e2e8f0; transition: background 0.2s;">
                        <span class="fs-4 text-secondary me-4" style="font-family: monospace; min-width: 40px;">@(index.ToString("D2"))</span>
                        <div>
                            <h5 class="mb-1 fw-bold">@topic.Title</h5>
                            @if (!string.IsNullOrEmpty(topic.Description))
                            {
                                // Show tiny snippet
                                var snippet = topic.Description.Length > 80 ? topic.Description.Substring(0, 80) + "..." : topic.Description;
                                <small class="text-secondary">@Html.Raw(System.Text.RegularExpressions.Regex.Replace(snippet, "<.*?>", ""))</small>
                            }
                        </div>
                        <span class="ms-auto text-info">&rarr;</span>
                    </a>
                    index++;
                }
            </div>
        }
        else
        {
            <div class="alert text-center py-5" style="background: rgba(15, 23, 42, 0.6); border: 1px solid rgba(255,255,255,0.1); border-radius: 12px;">
                <p class="text-secondary fs-5 mb-0">This course currently has no published topics.</p>
                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    <a asp-controller="Topics" asp-action="Create" asp-route-courseId="@Model.Id" class="btn btn-sm btn-outline-primary mt-3">Add Topic</a>
                }
            </div>
        }
        
        <div class="mt-5">
            <a asp-controller="Learn" asp-action="Index" class="btn btn-outline-secondary">&larr; Back to Catalog</a>
        </div>
    </div>
</div>
